{
  "name": "handy",
  "title": "Atari Lynx",
  "version": "0.1.0",
  "description": "Atari Lynx emulator. Put a Lynx ROM in /sd/roms/handy/.",
  "author": "RetroESP32-P4 port",
  "category": "Emulator",
  "license": "See the upstream project license.",
  "about": "Atari Lynx emulator. Put a Lynx ROM in /sd/roms/handy/.",
  "controls": [
    "D-pad: directional input",
    "A / B: primary emulator buttons",
    "Start / Select: emulator controls",
    "Menu: quit to launcher"
  ],
  "upstream": {
    "project": "Handy",
    "version": "0.95",
    "url": "https://github.com/HandyEmu/Handy"
  },
  "icon": "icon.png",
  "requires": [
    {
      "path": "/sd/roms/handy/",
      "note": "Place a compatible ROM or disk image here"
    }
  ],
  "build": "custom",
  "source": {
    "repo": "https://github.com/NonaSuomy/RetroESP32-P4",
    "ref": "ae04c88d166c55fa60722276ccc1cc50b7d100f2",
    "path": "components/psram_app_loader"
  },
  "includes": [
    "local:ports/retroesp32/apps/psram_handy",
    "local:ports/retroesp32/components/handy",
    "local:ports/retroesp32/apps/papp_emulator_common",
    "local:ports/retroesp32/apps/papp_emulator_common/compat_cxx",
    "local:ports/retroesp32/apps/psram_c64",
    "local:ports/retroesp32/components"
  ],
  "cflags": [
    "-DPAPP_APP_SIDE=1",
    "-DIRAM_ATTR=",
    "-std=gnu99",
    "-O2",
    "-fno-common",
    "-ffunction-sections",
    "-fdata-sections",
    "-Wall",
    "-Wno-format",
    "-Wno-unused-variable",
    "-Wno-unused-function",
    "-Wno-maybe-uninitialized",
    "-Wno-implicit-function-declaration",
    "-Wno-pointer-sign",
    "-Wno-int-conversion",
    "-Wno-incompatible-pointer-types",
    "-Wno-sign-compare",
    "-Wno-missing-braces",
    "-DPAPP_HANDY=1",
    "-DMY_VSYNC_DISABLE",
    "-include",
    "stdint.h",
    "-include",
    "stdbool.h"
  ],
  "cxxflags": [
    "-std=gnu++17",
    "-D_Static_assert=static_assert",
    "-fno-exceptions",
    "-fno-rtti",
    "-fno-threadsafe-statics",
    "-fno-use-cxa-atexit",
    "-fno-unwind-tables",
    "-fno-asynchronous-unwind-tables",
    "-Wno-write-strings",
    "-Wno-narrowing",
    "-Wno-overloaded-virtual"
  ],
  "groups": [
    {
      "dir": "local:ports/retroesp32/components/handy",
      "files": [
        "cart.cpp",
        "eeprom.cpp",
        "lynxdec.cpp",
        "memmap.cpp",
        "mikie.cpp",
        "ram.cpp",
        "rom.cpp",
        "susie.cpp",
        "system.cpp"
      ],
      "prefix": "core_"
    },
    {
      "dir": "local:ports/retroesp32/apps/psram_handy",
      "files": [
        "papp_main.cpp"
      ],
      "prefix": "app_"
    },
    {
      "dir": "local:ports/retroesp32/apps/papp_emulator_common",
      "files": [
        "papp_libc.c"
      ],
      "prefix": "common_"
    },
    {
      "dir": "local:ports/retroesp32/apps/psram_c64",
      "files": [
        "papp_syscalls.c"
      ],
      "prefix": "sys_"
    }
  ],
  "ldflags": [
    "-Wl,--allow-multiple-definition",
    "-Wl,--wrap=fopen",
    "-Wl,--wrap=fclose",
    "-Wl,--wrap=fread",
    "-Wl,--wrap=fwrite",
    "-Wl,--wrap=fseek",
    "-Wl,--wrap=ftell",
    "-Wl,--wrap=rewind",
    "-Wl,--wrap=getc",
    "-Wl,--wrap=fgetc",
    "-Wl,--wrap=exit"
  ],
  "newlib": true
}
