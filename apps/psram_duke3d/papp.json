{
  "name": "psram_duke3d",
  "title": "Duke Nukem 3D",
  "version": "0.1.2",
  "description": "Duke Nukem 3D (BUILD engine) as a PSRAM app. The store downloads the shareware duke3d.grp to /sd/roms/duke3d/.",
  "author": "3D Realms / Ken Silverman; P4 port by giltal",
  "category": "Game",
  "license": "GPL-2.0 + BUILD licence",
  "about": "Duke Nukem 3D on the BUILD engine, as a PSRAM app. The store downloads the shareware episode (duke3d.grp) on first launch; your own full duke3d.grp on the card is used instead and never replaced.",
  "controls": [
    "Up/Down: move forward / back; menus",
    "Left/Right: turn",
    "A: fire",
    "B: open / use; menu select",
    "X: jump",
    "Y: crouch",
    "L / R: previous / next weapon",
    "Select: automap",
    "Start: menu / back",
    "Menu (hold 3 s): quit to launcher"
  ],
  "upstream": {
    "project": "Chocolate Duke Nukem 3D",
    "version": "1.0",
    "url": "https://github.com/fabiensanglard/chocolate_duke3D"
  },
  "icon": "icon_msdos.png",
  "build": "custom",
  "source": {
    "repo": "https://github.com/giltal/RetroESP32-P4",
    "ref": "339f17ff74eea4fe250d749fdcf0b5e544519c2a",
    "path": "apps/psram_duke3d"
  },
  "includes": [
    "apps/psram_duke3d/compat",
    "components/psram_app_loader/include",
    "components/duke3d/Engine",
    "components/duke3d/Game",
    "components/duke3d/audiolib"
  ],
  "cflags": [
    "-DPAPP_APP_SIDE=1",
    "-DIRAM_ATTR=",
    "-DEXT_RAM_ATTR=",
    "-DPLATFORM_SUPPORTS_SDL=1",
    "-DPLATFORM_ESP32=1",
    "-DSTUB_NETWORKING=1",
    "-std=gnu17",
    "-Os",
    "-fcommon",
    "-ffunction-sections",
    "-fdata-sections",
    "-Wall",
    "-Wno-format",
    "-Wno-unused-variable",
    "-Wno-unused-function",
    "-Wno-maybe-uninitialized",
    "-Wno-implicit-function-declaration",
    "-Wno-pointer-sign",
    "-Wno-int-conversion",
    "-Wno-incompatible-pointer-types",
    "-Wno-dangling-pointer",
    "-Wno-array-bounds",
    "-Wno-address",
    "-Wno-restrict",
    "-Wno-builtin-declaration-mismatch",
    "-Wno-char-subscripts",
    "-Wno-sign-compare",
    "-Wno-parentheses",
    "-Wno-missing-braces",
    "-Wno-return-type",
    "-Wno-stringop-overflow",
    "-Wno-stringop-truncation"
  ],
  "groups": [
    {
      "dir": "components/duke3d/Engine",
      "prefix": "eng_",
      "files": [
        "cache.c",
        "display.c",
        "draw.c",
        "dummy_multi.c",
        "engine.c",
        "filesystem.c",
        "fixedPoint_math.c",
        "tiles.c"
      ]
    },
    {
      "dir": "components/duke3d/Game",
      "prefix": "game_",
      "files": [
        "actors.c",
        "animlib.c",
        "config.c",
        "console.c",
        "control.c",
        "cvar_defs.c",
        "cvars.c",
        "game.c",
        "gamedef.c",
        "global.c",
        "keyboard.c",
        "menues.c",
        "player.c",
        "premap.c",
        "rts.c",
        "scriplib.c",
        "sector.c",
        "sounds.c",
        "dummy_audiolib.c"
      ]
    },
    {
      "dir": "components/duke3d/audiolib",
      "prefix": "aud_",
      "files": [
        "fx_man.c",
        "dsl.c",
        "ll_man.c",
        "multivoc.c",
        "mv_mix.c",
        "mvreverb.c",
        "nodpmi.c",
        "pitch.c",
        "user.c",
        "nomusic.c"
      ]
    },
    {
      "dir": "apps/psram_duke3d",
      "prefix": "papp_",
      "files": [
        "papp_main.c",
        "papp_syscalls.c",
        "papp_sdl_video.c",
        "papp_sdl_audio.c",
        "papp_sdl_event.c",
        "papp_sdl_system.c"
      ]
    }
  ],
  "ldflags": [
    "-Wl,--allow-multiple-definition"
  ],
  "newlib": true,
  "data": {
    "repo": "https://github.com/NonaSuomy/RetroESP32-P4",
    "ref": "ae04c88d166c55fa60722276ccc1cc50b7d100f2",
    "license": "DUKE3D.GRP from the Duke Nukem 3D shareware release (episode 1 only, contains DUKESW.BIN), which 3D Realms allowed to be freely distributed.",
    "files": [
      {
        "path": "SDcard/roms/duke3d/DUKE3D.grp",
        "target": "roms/duke3d/duke3d.grp",
        "size": 10442980,
        "sha256": "b218feef4a7b0e48027de17746bd744dc0624b275b9dac0ea8a726f85b48887f"
      }
    ]
  }
}
