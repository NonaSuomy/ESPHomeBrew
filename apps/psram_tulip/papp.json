{
  "name": "psram_tulip",
  "title": "Tulip CC",
  "version": "0.1.0",
  "description": "Tulip Creative Computer (MicroPython, the AMY synthesizer, Tulip's graphics, editor and LVGL UI) as a PAPP, at 800x480 with USB keyboard, touch and the loader's speaker. Work in progress.",
  "author": "shorepine (Tulip, AMY); PAPP port",
  "category": "Tool",
  "license": "MIT (Tulip, MicroPython, AMY, LVGL)",
  "about": "Tulip is a self-contained computer for music, graphics and code: a MicroPython REPL and editor, the AMY synthesizer, sprites, a background layer and an LVGL user interface. This port runs Tulip Desktop's code on the ESP32-P4 loader: Tulip's display at 800x480 shown 1:1, AMY at 44.1 kHz on the loader's speaker, USB keyboard to the REPL and editor, touch as Tulip's touch and LVGL pointer. Tulip's files live in a 16 MiB filesystem image, /sd/roms/tulip/tulip.lfs, made on first start (create the folder /sd/roms/tulip first); the card itself is at /sd for opening files by name. No network, MIDI or native C modules yet.",
  "controls": [
    "USB keyboard: the REPL and editor",
    "Ctrl, then a key: Ctrl-C, Ctrl-X, Ctrl-Q, Ctrl-Tab",
    "Arrows / D-pad: history, cursor; Tulip joystick",
    "Touch: Tulip touch and LVGL",
    "Menu or Escape held 3 s: quit to the launcher",
    "Ctrl-D on an empty line: quit to the launcher"
  ],
  "upstream": {
    "project": "Tulip Creative Computer",
    "url": "https://github.com/shorepine/tulipcc"
  },
  "icon": "icon.png",
  "publish": true,
  "build": "custom",
  "source": {
    "repo": "https://github.com/NonaSuomy/tulipcc",
    "ref": "4469977fb87b6abfe8bc8ae7646e17d7eeb5c9fa",
    "path": "tulip/shared"
  },
  "submodules": [
    {
      "path": "micropython",
      "repo": "https://github.com/micropython/micropython",
      "ref": "82e69df33e379bf491bea647e217d6d56c5b8090"
    },
    {
      "path": "amy",
      "repo": "https://github.com/shorepine/amy",
      "ref": "5c97024f01bd112fc24170299f0d5a0da1f489ed"
    }
  ],
  "paths": [
    "tulip/shared/py",
    "tulip/fs/tulip",
    "micropython/tools",
    "micropython/mpy-cross",
    "micropython/lib/oofatfs",
    "micropython/lib/re1.5",
    "micropython/lib/uzlib",
    "micropython/lib/crypto-algorithms",
    "amy/amy",
    "lv_binding_micropython_tulip/lv_conf.h",
    "lv_binding_micropython_tulip/lvgl/lvgl.h",
    "lv_binding_micropython_tulip/gen",
    "lv_binding_micropython_tulip/pycparser",
    "lv_binding_micropython_tulip/include"
  ],
  "patches": [
    "local:ports/tulip/patches/*.patch"
  ],
  "prebuild": [
    [
      "{python}",
      "{repo}/ports/tulip/gen_tulip.py",
      "--src",
      "{src}",
      "--gen",
      "{gen}",
      "--units",
      "{units}",
      "--jobs",
      "{jobs}"
    ]
  ],
  "linker_script": "local:ports/redalert/papp_cpp.ld",
  "includes": [
    "local:ports/tulip",
    "local:ports/tulip/include",
    "local:",
    "micropython",
    ".papp-gen",
    "tulip/shared",
    "tulip/shared/ulab/code",
    "amy/src",
    "lv_binding_micropython_tulip",
    "lv_binding_micropython_tulip/lvgl/src"
  ],
  "cflags": [
    "-std=gnu11",
    "-O2",
    "-fno-strict-aliasing",
    "-ffunction-sections",
    "-fdata-sections",
    "-DPAPP_APP_SIDE=1",
    "-DTULIP_PAPP",
    "-DSTATIC=static",
    "-DAMY_HOST_MIDI=1",
    "-DAMY_NO_MINIAUDIO",
    "-DLV_CONF_INCLUDE_SIMPLE",
    "-DMODULE_ULAB_ENABLED=1",
    "-DLFS2_NO_MALLOC",
    "-DLFS2_NO_DEBUG",
    "-DLFS2_NO_WARN",
    "-DLFS2_NO_ERROR",
    "-DLFS2_NO_ASSERT",
    "-Wno-unused-variable",
    "-Wno-unused-function",
    "-Wno-unused-but-set-variable",
    "-Wno-maybe-uninitialized",
    "-Wno-sign-compare",
    "-Wno-format",
    "-Wno-pointer-sign",
    "-Wno-incompatible-pointer-types",
    "-Wno-int-conversion",
    "-Wno-discarded-qualifiers",
    "-Wno-error=implicit-function-declaration",
    "-Wno-error=implicit-int",
    "-Wno-error=return-mismatch"
  ],
  "groups": [
    {
      "dir": "micropython/py",
      "prefix": "py_",
      "files": [
        "*.c"
      ]
    },
    {
      "dir": "micropython/extmod",
      "prefix": "extmod_",
      "files": [
        "modasyncio.c",
        "modbinascii.c",
        "moddeflate.c",
        "modframebuf.c",
        "modhashlib.c",
        "modheapq.c",
        "modjson.c",
        "modos.c",
        "modplatform.c",
        "modrandom.c",
        "modre.c",
        "modselect.c",
        "modtime.c",
        "moductypes.c",
        "modvfs.c",
        "vfs.c",
        "vfs_blockdev.c",
        "vfs_lfs.c",
        "vfs_reader.c"
      ]
    },
    {
      "dir": "micropython/lib/littlefs",
      "prefix": "lfs_",
      "files": [
        "lfs2.c",
        "lfs2_util.c"
      ]
    },
    {
      "dir": "micropython/shared",
      "prefix": "shared_",
      "files": [
        "readline/readline.c",
        "runtime/pyexec.c",
        "runtime/interrupt_char.c",
        "runtime/gchelper_generic.c",
        "runtime/sys_stdio_mphal.c",
        "timeutils/timeutils.c"
      ]
    },
    {
      "dir": "tulip/shared",
      "prefix": "tulip_",
      "files": [
        "modtulip.c",
        "polyfills.c",
        "smallfont.c",
        "bigfont.c",
        "display.c",
        "u8g2_fonts.c",
        "u8fontdata.c",
        "bresenham.c",
        "ui.c",
        "help.c",
        "tulip_helpers.c",
        "editor.c",
        "keyscan.c",
        "amy_connector.c",
        "lodepng.c",
        "tsequencer.c",
        "lvgl_u8g2.c"
      ]
    },
    {
      "dir": "tulip/shared/ulab/code",
      "prefix": "ulab_",
      "files": [
        "scipy/integrate/integrate.c",
        "scipy/linalg/linalg.c",
        "scipy/optimize/optimize.c",
        "scipy/signal/signal.c",
        "scipy/special/special.c",
        "ndarray_operators.c",
        "ulab_tools.c",
        "ndarray.c",
        "numpy/ndarray/ndarray_iter.c",
        "ndarray_properties.c",
        "numpy/approx.c",
        "numpy/bitwise.c",
        "numpy/compare.c",
        "numpy/carray/carray.c",
        "numpy/carray/carray_tools.c",
        "numpy/create.c",
        "numpy/fft/fft.c",
        "numpy/fft/fft_tools.c",
        "numpy/filter.c",
        "numpy/io/io.c",
        "numpy/linalg/linalg.c",
        "numpy/linalg/linalg_tools.c",
        "numpy/numerical.c",
        "numpy/poly.c",
        "numpy/random/random.c",
        "numpy/stats.c",
        "numpy/transform.c",
        "numpy/vector.c",
        "numpy/numpy.c",
        "scipy/scipy.c",
        "user/user.c",
        "utils/utils.c",
        "ulab.c"
      ]
    },
    {
      "dir": "amy/src",
      "prefix": "amy_",
      "files": [
        "amy.c",
        "algorithms.c",
        "custom.c",
        "patches.c",
        "delay.c",
        "envelope.c",
        "filters.c",
        "oscillators.c",
        "transfer.c",
        "sequencer.c",
        "pcm.c",
        "log2_exp2.c",
        "interp_partials.c",
        "parse.c",
        "amy_midi.c",
        "instrument.c",
        "api.c",
        "midi_mappings.c",
        "cv_trigger.c"
      ]
    },
    {
      "dir": "lv_binding_micropython_tulip/lvgl/src",
      "prefix": "lv_",
      "files": [
        "*.c",
        "core/**/*.c",
        "display/**/*.c",
        "draw/**/*.c",
        "font/**/*.c",
        "indev/**/*.c",
        "layouts/**/*.c",
        "libs/**/*.c",
        "misc/**/*.c",
        "osal/**/*.c",
        "others/**/*.c",
        "stdlib/**/*.c",
        "themes/**/*.c",
        "tick/**/*.c",
        "widgets/**/*.c"
      ]
    },
    {
      "dir": ".papp-gen",
      "prefix": "gen_",
      "files": [
        "lv_mpy.c",
        "frozen_content.c",
        "sys_tar.c"
      ]
    },
    {
      "dir": "local:ports/tulip",
      "prefix": "papp_",
      "files": [
        "papp_main.c",
        "papp_mphal.c",
        "papp_syscalls.c",
        "papp_display.c",
        "papp_audio.c",
        "papp_vfs.c",
        "papp_stubs.c"
      ]
    }
  ],
  "ldflags": [
    "-Wl,--wrap=exit"
  ],
  "newlib": true
}
