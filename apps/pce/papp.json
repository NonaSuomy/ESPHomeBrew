{
  "name": "pce",
  "title": "PC Engine",
  "version": "0.1.0",
  "description": "PC Engine and TurboGrafx-16 emulator. Put a ROM image in /sd/roms/pce/.",
  "author": "RetroESP32-P4 port",
  "category": "Emulator",
  "license": "See the upstream project license.",
  "about": "PC Engine and TurboGrafx-16 emulator. Put a ROM image in /sd/roms/pce/.",
  "controls": [
    "D-pad: directional input",
    "A / B: primary emulator buttons",
    "Start / Select: emulator controls",
    "Menu: quit to launcher"
  ],
  "upstream": {
    "project": "HuExpress",
    "url": "https://github.com/uli/hugo"
  },
  "icon": "icon.png",
  "requires": [
    {
      "path": "/sd/roms/pce/",
      "note": "Place a compatible ROM or disk image here"
    }
  ],
  "build": "custom",
  "source": {
    "repo": "https://github.com/NonaSuomy/RetroESP32-P4",
    "ref": "ae04c88d166c55fa60722276ccc1cc50b7d100f2",
    "path": "components/psram_app_loader"
  },
  "includes": [
    "local:ports/retroesp32/apps/psram_pce",
    "local:ports/retroesp32/components/huexpress",
    "local:ports/retroesp32/components/huexpress/includes",
    "local:ports/retroesp32/components/huexpress/engine",
    "local:ports/retroesp32/apps/papp_emulator_common",
    "local:ports/retroesp32/apps/papp_emulator_common/compat",
    "local:ports/retroesp32/apps/psram_c64",
    "local:ports/retroesp32/components"
  ],
  "cflags": [
    "-DPAPP_APP_SIDE=1",
    "-DIRAM_ATTR=",
    "-std=gnu99",
    "-O2",
    "-fno-common",
    "-ffunction-sections",
    "-fdata-sections",
    "-Wall",
    "-Wno-format",
    "-Wno-unused-variable",
    "-Wno-unused-function",
    "-Wno-maybe-uninitialized",
    "-Wno-implicit-function-declaration",
    "-Wno-pointer-sign",
    "-Wno-int-conversion",
    "-Wno-incompatible-pointer-types",
    "-Wno-sign-compare",
    "-Wno-missing-braces",
    "-DPAPP_PCE=1",
    "-DMY_VSYNC_DISABLE",
    "-DLSB_FIRST=1",
    "-DPATH_MAX=512",
    "-include",
    "stdint.h",
    "-include",
    "stdbool.h",
    "-include",
    "esp_attr.h"
  ],
  "cxxflags": [
    "-std=gnu++17",
    "-D_Static_assert=static_assert",
    "-fno-exceptions",
    "-fno-rtti",
    "-fno-threadsafe-statics",
    "-fno-use-cxa-atexit",
    "-fno-unwind-tables",
    "-fno-asynchronous-unwind-tables",
    "-Wno-write-strings",
    "-Wno-narrowing",
    "-Wno-overloaded-virtual"
  ],
  "groups": [
    {
      "dir": "local:ports/retroesp32/components/huexpress",
      "files": [
        "engine/bios.c",
        "engine/bp.c",
        "engine/cd.c",
        "engine/cheat.c",
        "engine/debug.c",
        "engine/dis.c",
        "engine/edit_ram.c",
        "engine/followop.c",
        "engine/format.c",
        "engine/gfx.c",
        "engine/h6280.c",
        "engine/hard_pce.c",
        "engine/hcd.c",
        "engine/lsmp3.c",
        "engine/mix.c",
        "engine/ogglength.c",
        "engine/optable.c",
        "engine/pce.c",
        "engine/pcecd.c",
        "engine/romdb.c",
        "engine/sound.c",
        "engine/sprite.c",
        "engine/subs_eagle.c",
        "engine/trans_fx.c",
        "iniconfig.c",
        "utils.c"
      ],
      "prefix": "core_"
    },
    {
      "dir": "local:ports/retroesp32/apps/psram_pce",
      "files": [
        "papp_main.c"
      ],
      "prefix": "app_"
    },
    {
      "dir": "local:ports/retroesp32/apps/papp_emulator_common",
      "files": [
        "papp_libc.c"
      ],
      "prefix": "common_"
    },
    {
      "dir": "local:ports/retroesp32/apps/psram_c64",
      "files": [
        "papp_syscalls.c"
      ],
      "prefix": "sys_"
    }
  ],
  "ldflags": [
    "-Wl,--allow-multiple-definition",
    "-Wl,--wrap=fopen",
    "-Wl,--wrap=fclose",
    "-Wl,--wrap=fread",
    "-Wl,--wrap=fwrite",
    "-Wl,--wrap=fseek",
    "-Wl,--wrap=ftell",
    "-Wl,--wrap=rewind",
    "-Wl,--wrap=getc",
    "-Wl,--wrap=fgetc",
    "-Wl,--wrap=exit"
  ],
  "newlib": true
}
