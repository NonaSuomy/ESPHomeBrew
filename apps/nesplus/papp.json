{
  "name": "nesplus",
  "title": "NES Plus",
  "version": "0.1.0",
  "description": "NoFrendo NES Plus emulator rebuilt as a current ESPHomeBrew PAPP.",
  "author": "NoFrendo; P4 port by RetroESP32-P4",
  "category": "Emulator",
  "license": "GPL-2.0",
  "about": "Nintendo Entertainment System emulator with broad mapper support. Put a .nes ROM or ZIP archive in /sd/roms/nesplus/.",
  "controls": [
    "D-pad: directional input",
    "A: NES A",
    "B: NES B",
    "Start / Select: NES controls",
    "Menu: quit to launcher"
  ],
  "upstream": {
    "project": "NoFrendo",
    "url": "https://github.com/fhoedemakers/nofrendo"
  },
  "icon": "icon.png",
  "requires": [
    {
      "path": "/sd/roms/nesplus/",
      "note": "Add a .nes ROM or ZIP archive"
    }
  ],
  "build": "custom",
  "source": {
    "repo": "https://github.com/NonaSuomy/RetroESP32-P4",
    "ref": "ae04c88d166c55fa60722276ccc1cc50b7d100f2",
    "path": "components/psram_app_loader"
  },
  "includes": [
    "local:ports/retroesp32/apps/psram_nesplus",
    "local:ports/retroesp32/components/nofrendo_rg",
    "local:ports/retroesp32/components/nofrendo_rg/nes",
    "local:ports/retroesp32/components/nofrendo_rg/mappers",
    "local:ports/retroesp32/apps/papp_emulator_common",
    "local:ports/retroesp32/apps/papp_emulator_common/compat",
    "local:ports/retroesp32/apps/psram_c64",
    "local:ports/retroesp32/components"
  ],
  "cflags": [
    "-DPAPP_APP_SIDE=1",
    "-DIRAM_ATTR=",
    "-std=gnu99",
    "-O2",
    "-fno-common",
    "-ffunction-sections",
    "-fdata-sections",
    "-Wall",
    "-Wno-format",
    "-Wno-unused-variable",
    "-Wno-unused-function",
    "-Wno-maybe-uninitialized",
    "-Wno-implicit-function-declaration",
    "-Wno-pointer-sign",
    "-Wno-int-conversion",
    "-Wno-incompatible-pointer-types",
    "-Wno-sign-compare",
    "-Wno-missing-braces",
    "-DNESPLUS_PAPP=1"
  ],
  "cxxflags": [
    "-std=gnu++17",
    "-D_Static_assert=static_assert",
    "-fno-exceptions",
    "-fno-rtti",
    "-fno-threadsafe-statics",
    "-fno-use-cxa-atexit",
    "-fno-unwind-tables",
    "-fno-asynchronous-unwind-tables",
    "-Wno-write-strings",
    "-Wno-narrowing",
    "-Wno-overloaded-virtual"
  ],
  "groups": [
    {
      "dir": "local:ports/retroesp32/components/nofrendo_rg",
      "files": [
        "**/*.c"
      ],
      "prefix": "core_"
    },
    {
      "dir": "local:ports/retroesp32/apps/psram_nesplus",
      "files": [
        "papp_main.c"
      ],
      "prefix": "app_"
    },
    {
      "dir": "local:ports/retroesp32/apps/papp_emulator_common",
      "files": [
        "papp_libc.c"
      ],
      "prefix": "common_"
    },
    {
      "dir": "local:ports/retroesp32/apps/psram_c64",
      "files": [
        "papp_syscalls.c"
      ],
      "prefix": "sys_"
    }
  ],
  "ldflags": [
    "-Wl,--allow-multiple-definition",
    "-Wl,--wrap=fopen",
    "-Wl,--wrap=fclose",
    "-Wl,--wrap=fread",
    "-Wl,--wrap=fwrite",
    "-Wl,--wrap=fseek",
    "-Wl,--wrap=ftell",
    "-Wl,--wrap=rewind",
    "-Wl,--wrap=getc",
    "-Wl,--wrap=fgetc",
    "-Wl,--wrap=exit"
  ],
  "newlib": true
}
