+#include <strings.h>
+
+/* ports/netsurf/papp_main.c: option defaults for the PAPP device */
+void papp_netsurf_set_defaults(void);
+
+static void fb_update_back_forward(struct gui_window *gw);
+
+/* focus an empty url bar, ready for a new address */
+static void fb_papp_focus_url(struct gui_window *gw)
+{
+	nsfb_event_t event;
+
+	if (gw->url == NULL)
+		return;
+	memset(&event, 0, sizeof(event));
+	event.type = NSFB_EVENT_KEY_DOWN;
+	event.value.keycode = NSFB_KEY_MOUSE_1;
+	fbtk_set_text(gw->url, "");
+	fbtk_set_focus(gw->url);
+	fbtk_post_callback(gw->url, FBTK_CBT_CLICK, &event, 0, 0);
+}
+
+/* ports/netsurf/papp_http.c: whether the loader offers TLS */
+int papp_have_tls(void);
+
+/* an address as typed: a path is a file on the card and a name without
+ * a scheme is a web site, https: when the loader has TLS, except for
+ * local names and numeric addresses, which get http: */
+static nserror fb_papp_url(const char *text, nsurl **url)
+{
+	const char *prefix;
+	char *full;
+	size_t len;
+	nserror error;
+
+	while (*text == ' ')
+		text++;
+	if (text[0] == '/') {
+		prefix = "file://";
+	} else if (strstr(text, "://") == NULL &&
+		   strncasecmp(text, "about:", 6) != 0 &&
+		   strncasecmp(text, "data:", 5) != 0 &&
+		   strncasecmp(text, "file:", 5) != 0 &&
+		   strncasecmp(text, "resource:", 9) != 0 &&
+		   strncasecmp(text, "javascript:", 11) != 0) {
+		size_t hostlen = strcspn(text, ":/?#");
+		bool local = (memchr(text, '.', hostlen) == NULL) ||
+			(strspn(text, "0123456789.") >= hostlen);
+		prefix = (papp_have_tls() && !local) ? "https://" : "http://";
+	} else {
+		return nsurl_create(text, url);
+	}
+	len = strlen(prefix) + strlen(text) + 1;
+	full = malloc(len);
+	if (full == NULL)
+		return NSERROR_NOMEM;
+	snprintf(full, len, "%s%s", prefix, text);
+	error = nsurl_create(full, url);
+	free(full);
+	return error;
+}
+#endif
 
 fbtk_widget_t *fbtk;
 
