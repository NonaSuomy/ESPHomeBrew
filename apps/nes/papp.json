{
  "name": "nes",
  "title": "NES (nofrendo)",
  "version": "0.1.3",
  "description": "Nintendo Entertainment System emulator as a PSRAM app. Add .nes ROMs under /sd/roms/nes/ or /usb0/roms/nes/.",
  "author": "nofrendo; P4 PAPP port by NonaSuomy",
  "category": "Emulator",
  "license": "LGPL-2.0",
  "icon": "icon.png",
  "about": "The classic nofrendo 2.0 NES core running as an ESP32-P4 PAPP. The launcher selects a .nes ROM from the configured storage; no ROMs are bundled.",
  "changelog": "0.1.3 fixes ZIP ROM extraction (build against correct loader ABI header); 0.1.1 fixes a heap-corruption crash when closing the NES app.",
  "controls": [
    "D-pad: D-pad",
    "A / B: A / B",
    "Start / Select: Start / Select",
    "Menu or L+R: quit to launcher",
    "L3 / on-screen close: quit to launcher",
    "Save states are disabled in this port"
  ],
  "requires": [
    {"path": "/sd/roms/nes/", "note": "Place .nes or .zip ROMs here; Select game scans this folder", "optional": true}
  ],
  "upstream": {
    "project": "nofrendo",
    "version": "2.0",
    "url": "https://github.com/NonaSuomy/RetroESP32-P4/tree/main/components/nofrendo"
  },
  "build": "custom",
  "source": {
    "repo": "https://github.com/NonaSuomy/RetroESP32-P4",
    "ref": "b72144c85f74017c8c4bcaaa6d82fe65d8c0a6b5",
    "path": "apps/psram_nes"
  },
  "patches": [
    "local:ports/nes/patches/*.patch"
  ],
  "includes": [
    "apps/psram_nes",
    "apps/papp_emulator_common",
    "components/psram_app_loader/include",
    "components/nofrendo/include"
  ],
  "cflags": [
    "-DPAPP_APP_SIDE=1",
    "-DPAPP_NES=1",
    "-DIRAM_ATTR=",
    "-std=gnu99",
    "-O2",
    "-fno-common",
    "-ffunction-sections",
    "-fdata-sections",
    "-Wall",
    "-Wno-format",
    "-Wno-unused-variable",
    "-Wno-unused-function",
    "-Wno-maybe-uninitialized",
    "-Wno-implicit-function-declaration",
    "-Wno-pointer-sign",
    "-Wno-int-conversion",
    "-Wno-incompatible-pointer-types",
    "-Wno-sign-compare",
    "-Wno-missing-braces"
  ],
  "groups": [
    {
      "dir": "components/nofrendo",
      "files": [
        "bitmap.c",
        "config.c",
        "event.c",
        "gui.c",
