{
  "name": "gb",
  "title": "Game Boy",
  "version": "0.1.0",
  "description": "Gnuboy Game Boy and Game Boy Color emulator rebuilt as a current ESPHomeBrew PAPP.",
  "author": "Gnuboy; P4 port by RetroESP32-P4",
  "category": "Emulator",
  "license": "GPL-2.0",
  "about": "Runs .gb and .gbc ROMs, including ZIP archives, from /sd/roms/gb/.",
  "controls": [
    "D-pad: move and menu navigation",
    "A: Game Boy A",
    "B: Game Boy B",
    "Start: Start",
    "Select: Select",
    "Menu: quit to launcher"
  ],
  "upstream": {
    "project": "Gnuboy",
    "version": "1.0.3",
    "url": "https://github.com/pdox/gnuboy"
  },
  "icon": "icon.png",
  "requires": [
    {
      "path": "/sd/roms/gb/",
      "note": "Add a .gb or .gbc ROM, or a ZIP containing one"
    }
  ],
  "build": "custom",
  "source": {
    "repo": "https://github.com/NonaSuomy/RetroESP32-P4",
    "ref": "ae04c88d166c55fa60722276ccc1cc50b7d100f2",
    "path": "components/psram_app_loader"
  },
  "includes": [
    "local:ports/retroesp32/apps/psram_gb",
    "local:ports/retroesp32/apps/papp_emulator_common",
    "local:ports/retroesp32/apps/papp_emulator_common/compat",
    "local:ports/retroesp32/components/gnuboy/include",
    "local:ports/retroesp32/components/gnuboy"
  ],
  "cflags": [
    "-DPAPP_APP_SIDE=1",
    "-DPAPP_GB=1",
    "-DGNUBOY_NO_MINIZIP=1",
    "-DIS_LITTLE_ENDIAN=1",
    "-Dvid_init=gnuboy_vid_init",
    "-Dcpu=gnuboy_cpu",
    "-Drom_load=gnuboy_rom_load",
    "-std=gnu99",
    "-O2",
    "-fno-common",
    "-ffunction-sections",
    "-fdata-sections",
    "-Wall",
    "-Wno-format",
    "-Wno-unused-variable",
    "-Wno-unused-function",
    "-Wno-maybe-uninitialized",
    "-Wno-implicit-function-declaration",
    "-Wno-pointer-sign",
    "-Wno-int-conversion",
    "-Wno-incompatible-pointer-types",
    "-Wno-sign-compare",
    "-Wno-missing-braces"
  ],
  "groups": [
    {
      "dir": "local:ports/retroesp32/components/gnuboy",
      "files": [
        "cpu.c",
        "debug.c",
        "emu.c",
        "fastmem.c",
        "hw.c",
        "inflate.c",
        "lcd.c",
        "lcdc.c",
        "loader.c",
        "main.c",
        "mem.c",
        "newsound.c",
        "palette.c",
        "refresh.c",
        "rtc.c",
        "save.c",
        "sound.c"
      ]
    },
    {
      "dir": "local:ports/retroesp32/apps/psram_gb",
      "files": [
        "papp_main.c"
      ]
    },
    {
      "dir": "local:ports/retroesp32/apps/papp_emulator_common",
      "files": [
        "papp_libc.c"
      ],
      "prefix": "common_"
    },
    {
      "dir": "local:ports/retroesp32/apps/psram_c64",
      "files": [
        "papp_syscalls.c"
      ],
      "prefix": "sys_"
    }
  ],
  "ldflags": [
    "-Wl,--wrap=fopen",
    "-Wl,--wrap=fclose",
    "-Wl,--wrap=fread",
    "-Wl,--wrap=fwrite",
    "-Wl,--wrap=fseek",
    "-Wl,--wrap=ftell",
    "-Wl,--wrap=rewind",
    "-Wl,--wrap=getc",
    "-Wl,--wrap=fgetc",
    "-Wl,--wrap=exit"
  ],
  "newlib": true
}
