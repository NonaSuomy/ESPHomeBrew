+#ifdef PAPP_NETSURF
+/* ports/netsurf/papp_hotlist.c: bookmarks (NetSurf's hotlist) and history */
+void papp_netsurf_started(void);
+void papp_netsurf_stopping(void);
+bool papp_hotlist_has(struct nsurl *url);
+bool papp_hotlist_toggle(struct nsurl *url);
+
+/* Toolbar buttons 'a' (a star: bookmark this page) and 'k' (the
+ * bookmarks page), between the address bar and the throbber. */
+#undef NSFB_TOOLBAR_DEFAULT_LAYOUT
+#define NSFB_TOOLBAR_DEFAULT_LAYOUT "blfsruaktc"
+
+#define FB_PAPP_STAR_OFF "\xe2\x98\x86"	/* U+2606 white star */
+#define FB_PAPP_STAR_ON "\xe2\x98\x85"	/* U+2605 black star */
+#define FB_PAPP_LIST "\xe2\x98\xb0"	/* U+2630, three bars: a list */
+
+/* show on the star whether the page is bookmarked: filled or hollow */
+static void fb_papp_update_star(struct gui_window *gw, struct nsurl *url)
+{
+	bool on;
+
+	if (gw->papp_star == NULL)
+		return;
+	on = url != NULL && papp_hotlist_has(url);
+	fbtk_set_text(gw->papp_star, on ? FB_PAPP_STAR_ON : FB_PAPP_STAR_OFF);
+}
+
+/* bookmark the page, or remove its bookmark */
+static void fb_papp_toggle_bookmark(struct gui_window *gw)
+{
+	struct nsurl *url = browser_window_access_url(gw->bw);
+
+	if (url == NULL)
+		return;
+	papp_hotlist_toggle(url);
+	fb_papp_update_star(gw, url);
+}
+
+/* open one of NetSurf's own pages */
+static void fb_papp_open(struct gui_window *gw, const char *address)
+{
+	nsurl *url;
+
+	if (nsurl_create(address, &url) != NSERROR_OK)
+		return;
+	browser_window_navigate(gw->bw, url, NULL, BW_NAVIGATE_HISTORY,
+			NULL, NULL, NULL);
+	nsurl_unref(url);
+}
+
+static int fb_papp_star_click(fbtk_widget_t *widget, fbtk_callback_info *cbi)
+{
+	if (cbi->event->type == NSFB_EVENT_KEY_UP)
+		fb_papp_toggle_bookmark(cbi->context);
+	return 1;
+}
+
+static int fb_papp_hotlist_click(fbtk_widget_t *widget, fbtk_callback_info *cbi)
+{
+	if (cbi->event->type == NSFB_EVENT_KEY_UP)
+		fb_papp_open(cbi->context, "about:hotlist");
+	return 1;
+}
