{
  "name": "psram_netsurf",
  "title": "NetSurf",
  "version": "0.3.2",
  "changelog": "0.3.2: rebuilt after the PAPP build/toolchain updates.",
  "description": "The NetSurf web browser (framebuffer frontend) as a PAPP on the whole panel: http:// and https:// pages over the loader's network and TLS, files on the card and NetSurf's about: pages, with FreeType text in the DejaVu fonts, WebP and SVG images, bookmarks and history, touch, USB keyboard and mouse. Work in progress.",
  "author": "The NetSurf Developers; PAPP port",
  "category": "Tool",
  "license": "GPL-2.0; MIT, BSD, zlib, libpng, IJG, FTL, Bitstream Vera",
  "about": "NetSurf is a small, fast web browser with its own HTML and CSS engine. This port runs its framebuffer frontend on the whole panel (the store's Screen setting can pick 800x480) and draws text with FreeType in the DejaVu fonts (sans-serif, serif and monospace; built in for Latin, Greek and Cyrillic, with italics slanted). It shows HTML 4 and CSS 2 (partly CSS 3) pages, PNG, JPEG, GIF, BMP, ICO, WebP and SVG images, forms and cookies, but no JavaScript and no web fonts. It loads http:// pages over the loader's TCP services and https:// pages over its TLS service, which checks every certificate against the firmware's certificate bundle (sites it cannot verify do not open; there is no way to skip the check). Local files open as file:///sd/..., and NetSurf's about: pages work. The star in the toolbar bookmarks the page; the button next to it lists the bookmarks (about:hotlist), and about:history lists the pages visited. Tapping a text field opens the on-screen keyboard. Its files live in /sd/roms/netsurf/: Choices (options), Cookies, Hotlist (bookmarks), URLs (history), and optionally Messages, the full DejaVu fonts in fonts/ (more characters and real italics) or your own copies of default.css, welcome.html and the other built-in resources, which then replace the built-in ones. There is no disk cache. The folder is optional: without it NetSurf runs with its built-in defaults and keeps no cookies, bookmarks or history once it quits. Video and sound links (.mp4, .webm, .mkv, .mov, .avi, .ts, .mp3, .ogg, .opus, .m4a, or a video/audio answer) open in the Video Player (psram_video) when it is installed or in a library source; quitting it comes back to the page.",
  "controls": [
    "Touch: tap to click, drag the page to scroll",
    "Touch the scroll bars to drag them",
    "Tap a text field: the on-screen keyboard opens",
    "Bottom-right button: on-screen keyboard",
    "Star button: bookmark the page, or not (Ctrl-D)",
    "List button: bookmarks (Ctrl-B); Ctrl-H: history",
    "USB mouse: point, click; middle button drag scrolls",
    "USB keyboard: type; arrows, PgUp/PgDn, Home/End scroll",
    "F6 or Ctrl-L: new address; F5: reload",
    "Alt+Left / Alt+Right: back / forward",
    "Ctrl-+ / Ctrl-- / Ctrl-0: zoom",
    "Gamepad: A click, B back, Y reload",
    "Gamepad: Select address bar, Start Enter, L/R page",
    "Menu or Escape held 3 s: quit to the launcher",
    "Close button (grey, top right): quit to the launcher"
  ],
