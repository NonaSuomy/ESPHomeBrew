    "-Wno-parentheses",
    "-Wno-deprecated-declarations",
    "-Wno-discarded-qualifiers",
    "-Wno-switch",
    "-Wno-array-bounds",
    "-Wno-stringop-overflow",
    "-Wno-error=incompatible-pointer-types",
