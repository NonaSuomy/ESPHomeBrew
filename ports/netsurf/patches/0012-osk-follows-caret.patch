 static fbtk_widget_t *osk;
 
+#ifdef PAPP_NETSURF
+#include "utils/errors.h"
+#include "framebuffer/schedule.h"
+
+/* ports/netsurf/papp_surface.c: false once a USB keyboard has been used */
+int papp_osk_auto_allowed(void);
+
+static bool osk_auto = false; /* shown because a text field has the caret */
+static bool osk_top = false;  /* at the top of the screen, not the bottom */
+
+/* move the keyboard to the top or the bottom of the screen */
+static void
+osk_papp_move(bool top)
+{
+	int height;
+	bool mapped;
+
+	if (osk == NULL || top == osk_top)
+		return;
+	osk_top = top;
+	height = fbtk_get_height(osk);
+	mapped = osk->mapped;
+	if (mapped)
+		fbtk_set_mapping(osk, false);
+	fbtk_set_pos_and_size(osk, 0,
+			top ? 0 : fbtk_get_height(fbtk_get_root_widget(osk)) - height,
+			0, height);
+	if (mapped)
+		fbtk_set_mapping(osk, true);
+}
+
+static void
+osk_papp_hide_cb(void *p)
+{
+	fbtk_widget_t *root;
+
+	if (osk == NULL || !osk_auto)
+		return;
+	root = fbtk_get_root_widget(osk);
+	if (root->u.root.caret.owner != NULL)
+		return; /* a text field has the caret again */
+	osk_auto = false;
+	fbtk_set_mapping(osk, false);
+	osk_papp_move(false);
+}
+
+/* exported function documented in fbtk.h */
+void
+fbtk_papp_osk_caret(bool has_caret)
+{
+	if (osk == NULL)
+		return;
+	if (has_caret) {
+		if (!osk->mapped && papp_osk_auto_allowed()) {
+			fbtk_set_zorder(osk, INT_MIN);
+			fbtk_set_mapping(osk, true);
+			osk_auto = true;
+		}
+	} else if (osk_auto) {
+		/* hide it unless a text field takes the caret again soon
+		 * (the caret moving between fields, or to the address bar) */
+		framebuffer_schedule(100, osk_papp_hide_cb, NULL);
+	}
+}
+
+/* exported function documented in fbtk.h */
+bool
+fbtk_papp_osk_area(int *y0, int *y1)
+{
+	if (osk == NULL || !osk->mapped)
+		return false;
+	*y0 = fbtk_get_absy(osk);
+	*y1 = *y0 + fbtk_get_height(osk);
+	return true;
+}
+
+/* exported function documented in fbtk.h */
+void
+fbtk_papp_osk_place(bool top)
+{
+	osk_papp_move(top);
+}
+#endif
