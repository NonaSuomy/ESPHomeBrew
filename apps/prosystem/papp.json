{
  "name": "prosystem",
  "title": "Atari 7800",
  "version": "0.1.0",
  "description": "Atari 7800 emulator. Put a cartridge ROM in /sd/roms/prosystem/.",
  "author": "RetroESP32-P4 port",
  "category": "Emulator",
  "license": "See the upstream project license.",
  "about": "Atari 7800 emulator. Put a cartridge ROM in /sd/roms/prosystem/.",
  "controls": [
    "D-pad: directional input",
    "A / B: primary emulator buttons",
    "Start / Select: emulator controls",
    "Menu: quit to launcher"
  ],
  "upstream": {
    "project": "ProSystem",
    "url": "https://github.com/raz0red/ProSystem"
  },
  "icon": "icon.png",
  "requires": [
    {
      "path": "/sd/roms/prosystem/",
      "note": "Place a compatible ROM or disk image here"
    }
  ],
  "build": "custom",
  "source": {
    "repo": "https://github.com/NonaSuomy/RetroESP32-P4",
    "ref": "ae04c88d166c55fa60722276ccc1cc50b7d100f2",
    "path": "components/psram_app_loader"
  },
  "includes": [
    "local:ports/retroesp32/apps/psram_prosystem",
    "local:ports/retroesp32/components/prosystem",
    "local:ports/retroesp32/components/prosystem/include",
    "local:ports/retroesp32/apps/papp_emulator_common",
    "local:ports/retroesp32/apps/papp_emulator_common/compat",
    "local:ports/retroesp32/apps/psram_c64",
    "local:ports/retroesp32/components"
  ],
  "cflags": [
    "-DPAPP_APP_SIDE=1",
    "-DIRAM_ATTR=",
    "-std=gnu99",
    "-O2",
    "-fno-common",
    "-ffunction-sections",
    "-fdata-sections",
    "-Wall",
    "-Wno-format",
    "-Wno-unused-variable",
    "-Wno-unused-function",
    "-Wno-maybe-uninitialized",
    "-Wno-implicit-function-declaration",
    "-Wno-pointer-sign",
    "-Wno-int-conversion",
    "-Wno-incompatible-pointer-types",
    "-Wno-sign-compare",
    "-Wno-missing-braces"
  ],
  "cxxflags": [
    "-std=gnu++17",
    "-D_Static_assert=static_assert",
    "-fno-exceptions",
    "-fno-rtti",
    "-fno-threadsafe-statics",
    "-fno-use-cxa-atexit",
    "-fno-unwind-tables",
    "-fno-asynchronous-unwind-tables",
    "-Wno-write-strings",
    "-Wno-narrowing",
    "-Wno-overloaded-virtual"
  ],
  "groups": [
    {
      "dir": "local:ports/retroesp32/components/prosystem",
      "files": [
        "Bios.c",
        "Cartridge.c",
        "Database.c",
        "Hash.c",
        "Maria.c",
        "Memory.c",
        "Palette.c",
        "Pokey.c",
        "ProSystem.c",
        "Region.c",
        "Riot.c",
        "Sally.c",
        "Tia.c"
      ],
      "prefix": "core_"
    },
    {
      "dir": "local:ports/retroesp32/apps/psram_prosystem",
      "files": [
        "papp_main.c"
      ],
      "prefix": "app_"
    },
    {
      "dir": "local:ports/retroesp32/apps/papp_emulator_common",
      "files": [
        "papp_libc.c"
      ],
      "prefix": "common_"
    },
    {
      "dir": "local:ports/retroesp32/apps/psram_c64",
      "files": [
        "papp_syscalls.c"
      ],
      "prefix": "sys_"
    }
  ],
  "ldflags": [
    "-Wl,--allow-multiple-definition",
    "-Wl,--wrap=fopen",
    "-Wl,--wrap=fclose",
    "-Wl,--wrap=fread",
    "-Wl,--wrap=fwrite",
    "-Wl,--wrap=fseek",
    "-Wl,--wrap=ftell",
    "-Wl,--wrap=rewind",
    "-Wl,--wrap=getc",
    "-Wl,--wrap=fgetc",
    "-Wl,--wrap=exit"
  ],
  "newlib": true
}
