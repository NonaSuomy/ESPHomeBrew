+#ifdef PAPP_NETSURF
+#define FB_PAPP_OSK_MARGIN 8
+
+/* keep a caret at y..y+height in the page clear of the on-screen
+ * keyboard: scroll the page up, or when it cannot scroll that far, move
+ * the keyboard to the top of the screen */
+static void
+fb_papp_osk_follow(struct gui_window *g, int y, int height)
+{
+	struct browser_widget_s *bwidget = fbtk_get_userpw(g->browser);
+	int k0, k1, top, bottom;
+
+	if (!fbtk_papp_osk_area(&k0, &k1))
+		return;
+	top = fbtk_get_absy(g->browser) + y -
+		(bwidget->scrolly + bwidget->pany) - FB_PAPP_OSK_MARGIN;
+	bottom = top + height + 2 * FB_PAPP_OSK_MARGIN;
+	if (bottom <= k0 || top >= k1)
+		return; /* clear of the keyboard */
+	if (k0 == 0) {
+		/* the keyboard is at the top, over the caret: back down */
+		fbtk_papp_osk_place(false);
+		if (!fbtk_papp_osk_area(&k0, &k1) || bottom <= k0)
+			return;
+	}
+	widget_scroll_y(g, bottom - k0, false);
+	bottom = fbtk_get_absy(g->browser) + y + height -
+		(bwidget->scrolly + bwidget->pany) + FB_PAPP_OSK_MARGIN;
+	if (bottom > k0)
+		fbtk_papp_osk_place(true);
+}
+#endif
