+#ifdef PAPP_NETSURF
+/* whether two bounding boxes overlap */
+static bool
+fbtk_papp_overlap(const nsfb_bbox_t *a, const nsfb_bbox_t *b)
+{
+	return a->x0 < b->x1 && b->x0 < a->x1 && a->y0 < b->y1 && b->y0 < a->y1;
+}
+
+/* exported function documented in fbtk.h */
+bool
+fbtk_papp_covered(fbtk_widget_t *widget)
+{
+	nsfb_bbox_t area, above;
+	fbtk_widget_t *w, *s;
+
+	fbtk_get_bbox(widget, &area);
+	for (w = widget; w->parent != NULL; w = w->parent) {
+		for (s = w->prev; s != NULL; s = s->prev) {
+			if (s->mapped) {
+				fbtk_get_bbox(s, &above);
+				if (fbtk_papp_overlap(&area, &above))
+					return true;
+			}
+		}
+	}
+	return false;
+}
+#endif
