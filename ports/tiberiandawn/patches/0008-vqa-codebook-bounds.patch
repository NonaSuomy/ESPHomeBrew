+// Codebook buffers get MaxCBSize of slack: compressed codebook parts are
+// staged near the end and can run past MaxCBSize (see VQA_Load_CBPZ).
+#define VQA_CB_ALLOC(data) (2 * (unsigned)(data)->MaxCBSize)
+
 int VQA_Load_CBFZ(VQAHandle* handle, unsigned iffsize)
 {
     VQALoader* loader = &handle->VQABuf->Loader;
     VQACBNode* curcb = loader->CurCB;
     unsigned lcwoffset = handle->VQABuf->MaxCBSize - ((iffsize + 1) & 0xFFFE);
 
+    if (((iffsize + 1) & 0xFFFE) > handle->VQABuf->MaxCBSize) {
+        // Bigger than the codebook buffer: skip it rather than write before it.
+        return handle->StreamHandler(handle, VQACMD_SEEK, (void*)SEEK_CUR, (iffsize + 1) & (~1)) ? VQAERR_SEEK : VQAERR_NONE;
+    }
+
     if (handle->StreamHandler(handle, VQACMD_READ, &loader->CurCB->Buffer[lcwoffset], (iffsize + 1) & (~1))) {
         return VQAERR_READ;
     }
@@ -131,6 +140,11 @@ int VQA_Load_CBP0(VQAHandle* handle, unsigned iffsize)
     VQALoader* loader = &handle->VQABuf->Loader;
     VQACBNode* curcb = (VQACBNode*)loader->CurCB;
 
+    if (handle->VQABuf->Loader.PartialCBSize + ((iffsize + 1) & (~1)) > VQA_CB_ALLOC(handle->VQABuf)) {
+        // Past the end of the codebook buffer: skip this part.
